# Copy this file to .env and replace the placeholders for local development.
SECRET_KEY=REPLACE_WITH_A_GENERATED_DJANGO_SECRET_KEY
DEBUG=True
DATABASE_URL=postgresql://YOUR_DB_ROLE:YOUR_DB_PASSWORD@127.0.0.1:5432/autopos

# Optional local SMTP sink for testing student onboarding.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=autopos@example.invalid
SITE_URL=http://localhost:8000
